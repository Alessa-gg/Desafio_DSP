@model Sistema_de_Gestion.Models.Vehiculo

@{
    ViewBag.Title = "Eliminar vehículo";
}

<h2>Eliminar vehículo</h2>

<div class="alert alert-warning">
    ¿Está seguro de que desea eliminar este vehículo?
</div>

<dl class="dl-horizontal">

    <dt>Tipo</dt>
    <dd>@Model.TipoVehiculo</dd>

    <dt>Placa</dt>
    <dd>@Model.Placa</dd>

    <dt>Marca</dt>
    <dd>@Model.Marca</dd>

    <dt>Modelo</dt>
    <dd>@Model.Modelo</dd>

</dl>

@using (Html.BeginForm(
    "DeleteConfirmed",
    "Vehiculos",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <input type="hidden"
           name="placa"
           value="@Model.Placa" />

    <button type="submit" class="btn btn-danger">
        Eliminar
    </button>

    @Html.ActionLink(
            "Cancelar",
            "Index",
            null,
            new { @class = "btn btn-default" }
        )
}